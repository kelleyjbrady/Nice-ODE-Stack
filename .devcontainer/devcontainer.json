{
  "name": "ODE CUDA Container Builder",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false,
      "installDockerBuildx": true,
      "installDockerComposeSwitch": true
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.13"
    }
  },
  "remoteUser": "vscode",
  "remoteEnv": {
    "PATH": "/home/vscode/.local/bin:${containerEnv:PATH}"
  },
  "mounts": [
    "source=${localWorkspaceFolder}/../PK-Analysis,target=/workspaces/PK-Analysis,type=bind",
    "source=ode-cuda-agy,target=/home/vscode/.gemini/antigravity-cli,type=volume"
  ],
  "postCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.gemini && curl -LsSf https://astral.sh/uv/install.sh | sh && echo 'export PATH=\"$HOME/.local/bin:$PATH\"' >> ~/.bashrc && $HOME/.local/bin/uv tool install poetry==2.4.* && curl -fsSL https://antigravity.google/cli/install.sh | bash",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "ms-vscode-remote.remote-containers",
        "timonwong.shellcheck",
        "tamasfe.even-better-toml",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
